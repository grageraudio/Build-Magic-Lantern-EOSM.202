#ifndef EOSMCINEPROFILE_H

#define EOSMCINEPROFILE_H



#include <QString>

#include "ReceiptSettings.h"



struct EosmCinePresetMatch {

    bool matched;

    QString presetName;

    int stretchX;        // 100 = 1.0x, 200 = 2.0x anamorphic (for 4:3 Academy if toggled)

    int stretchY;        // 100 = 1.0x, 300 = 3.0x vertical de-squeeze (for S35 1x3 Scope)

    bool isHighSpeed;    // True for 50p / 58p 3x3 modes

    double conformFps;   // 25.0 for 50p clips, 29.97 for 60p clips

    bool isSuper16Crop;  // True for 1:1 unbinned crop modes (enables extra focus-pixel cleanup)

};



class EosmCineProfile {

public:

    static EosmCinePresetMatch detectPreset(int width, int height, double recordedFps);

    static void applyFilmicDefaults(ReceiptSettings *receipt, int width, int height, double recordedFps);

};



#endif // EOSMCINEPROFILE_H





#include "EosmCineProfile.h"

#include <cmath>



EosmCinePresetMatch EosmCineProfile::detectPreset(int width, int height, double recordedFps)

{

    EosmCinePresetMatch m = { false, "Standard MLV", 100, 100, false, recordedFps, false };



    /* 0: S35 2K 16:9 (3x3 Boot Default) */

    if (width == 1736 && height == 976) {

        m.matched = true;

        m.presetName = "S35 2K 16:9 (3x3)";

    }

    /* 1: S35 3:2 Open Gate (3x3) */

    else if (width == 1736 && height == 1156) {

        m.matched = true;

        m.presetName = "S35 3:2 Open Gate (3x3)";

    }

    /* 2: S35 4:3 Academy / 2x Anamorphic Gate (3x3) */

    else if (width == 1544 && height == 1156) {

        m.matched = true;

        m.presetName = "S35 4:3 Academy (3x3)";

    }

    /* 3: S35 2.39:1 Scope (1x3 Full-Width -> Auto 3.0x Vertical De-Squeeze) */

    else if (width == 3840 && height == 1640) {

        m.matched = true;

        m.presetName = "S35 2.39 Scope (1x3)";

        m.stretchY = 300;

    }

    /* 4: S16 1.66:1 European (1:1 Pixel Crop) */

    else if (width == 2288 && height == 1378) {

        m.matched = true;

        m.presetName = "S16 1.66:1 (1:1 Crop)";

        m.isSuper16Crop = true;

    }

    /* 5: S16 16:9 Widescreen (1:1 Pixel Crop) */

    else if (width == 2368 && height == 1332) {

        m.matched = true;

        m.presetName = "S16 16:9 (1:1 Crop)";

        m.isSuper16Crop = true;

    }

    /* 6: S16 3:4 Native Vertical Portrait (1:1 Pixel Crop) */

    else if (width == 1344 && height == 1792) {

        m.matched = true;

        m.presetName = "S16 3:4 Vertical (1:1)";

        m.isSuper16Crop = true;

    }

    /* 7: High-Speed 3x3 50p -> Auto-Conform to 25.000 fps Slow-Mo */

    else if (width == 1736 && height == 720) {

        m.matched = true;

        m.presetName = "HS 3x3 50p Slow-Mo";

        m.isHighSpeed = true;

        m.conformFps = 25.0;

    }

    /* 8: High-Speed 3x3 60p -> Auto-Conform to 29.970 fps Slow-Mo */

    else if (width == 1536 && height == 648) {

        m.matched = true;

        m.presetName = "HS 3x3 60p Slow-Mo";

        m.isHighSpeed = true;

        m.conformFps = 29.97;

    }



    return m;

}



void EosmCineProfile::applyFilmicDefaults(ReceiptSettings *receipt, int width, int height, double recordedFps)

{

    if (!receipt) return;



    EosmCinePresetMatch match = detectPreset(width, height, recordedFps);

    if (!match.matched) return;



    /* 1. Filmic Color & Debayer Pipeline */

    receipt->setDebayer(4);               // AMaZE debayer (sharpest for 3x3 & 1:1)

    receipt->setProfile(3);               // ARRI LogC transfer curve

    receipt->setHighlightReconstruction(true);

    receipt->setChromaSmooth(match.isSuper16Crop ? 2 : 1); // 2x2 on 1:1 S16, 1x1 on 3x3 S35

    receipt->setFixRaw(true);             // Focus-pixel & bad-pixel interpolation ON

    receipt->setDualIso(1);               // Auto-detect Dual ISO 100/800



    /* 2. Geometry & De-Squeeze */

    receipt->setStretchFactorX(match.stretchX);

    receipt->setStretchFactorY(match.stretchY);



    /* 3. High-Speed Slow-Motion Conform (50p -> 25p, 60p -> 29.97p) */

    if (match.isHighSpeed) {

        receipt->setOverrideFps(true);

        receipt->setFps(match.conformFps);

    }

}



